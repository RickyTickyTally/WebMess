{
  "manifest_version": 3,
  "name": "Site Chat",
  "version": "1.0.0",
  "description": "Реалтайм-чат для пользователей, находящихся на одном и том же URL.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://bibiswim-webmess.hf.space/*"
  ],
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Site Chat",
    "default_icon": "icon.png"
  }
}