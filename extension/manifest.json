{
  "manifest_version": 3,
  "name": "Site Chat",
  "version": "1.0.0",
  "description": "Реалтайм-чат для пользователей, находящихся на одном и том же URL.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Site Chat"
  }
}
